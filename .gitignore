# --- Secrets — NEVER commit these ---
.env
.env.*
!.env.example
*credentials*.json
*token*.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Virtual environment ---
venv/
.venv/
env/

# --- Personal lecture data (your own recordings/notes shouldn't be public) ---
sessions/
!sessions/.gitkeep
recordings/
!recordings/.gitkeep
photos/
!photos/.gitkeep

# --- Test / generated PDFs ---
test_*.pdf

# --- Backups ---
webapp_backup/
server_full_backup.py

# --- Model cache (faster-whisper downloads models here) ---
.cache/

# --- macOS ---
.DS_Store

# --- Editor ---
.vscode/
.idea/